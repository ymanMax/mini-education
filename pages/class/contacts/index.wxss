/* pages/class/contacts/index.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

.header_actions {
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
  text-align: right;
}

.add_btn {
  background: #FF4D61;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  display: inline-block;
}

.add_btn:active {
  opacity: 0.8;
}

.contacts_section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.section_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #eee;
}

.section_title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.section_toggle {
  font-size: 24rpx;
  color: #666;
}

.contacts_list {
  padding: 0 20rpx 20rpx;
}

.contact_item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact_item:last-child {
  border-bottom: none;
}

.contact_info {
  flex: 1;
}

.contact_name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.contact_role, .contact_relation {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.contact_phone {
  font-size: 26rpx;
  color: #409EFF;
}

.contact_actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.action_btn {
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  text-align: center;
}

.call_btn {
  background: #f0f9eb;
  color: #67c23a;
}

.message_btn {
  background: #e8f4fd;
  color: #409EFF;
}

.delete_btn {
  background: #fff1f0;
  color: #FF4D4F;
}

.action_btn:active {
  opacity: 0.8;
}

.empty_subsection {
  padding: 60rpx 0;
  text-align: center;
  color: #888;
  font-size: 24rpx;
}

/* 添加联系人模态框 */
.modal_box {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.add_modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  z-index: 1001;
  overflow: hidden;
  max-height: 80vh;
}

.modal_title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}

.modal_content {
  padding: 30rpx;
  max-height: calc(80vh - 200rpx);
  overflow-y: auto;
}

.form_item {
  margin-bottom: 30rpx;
}

.form_label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.type_select {
  display: flex;
}

.type_option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-right: 15rpx;
}

.type_option:last-child {
  margin-right: 0;
}

.type_option.selected {
  border-color: #FF4D61;
  background: #fff1f0;
  color: #FF4D61;
}

.form_input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form_input:focus {
  border-color: #FF4D61;
}

.modal_footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.btn_cancel, .btn_confirm {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
}

.btn_cancel {
  color: #666;
  border-right: 1rpx solid #eee;
}

.btn_confirm {
  color: #FF4D61;
}

.btn_cancel:active, .btn_confirm:active {
  background: #f5f5f5;
}
