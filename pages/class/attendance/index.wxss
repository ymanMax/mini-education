/* pages/class/attendance/index.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

.date_select {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date_label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.date_picker {
  font-size: 28rpx;
  color: #409EFF;
  padding: 10rpx 20rpx;
  border: 2rpx solid #409EFF;
  border-radius: 8rpx;
}

.attendance_list {
  background: #f5f5f5;
}

.attendance_item {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.student_info {
  flex: 1;
}

.student_name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.student_no {
  font-size: 24rpx;
  color: #888;
}

.attendance_status {
  margin-right: 20rpx;
}

.status_tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status_present {
  background: #f0f9eb;
  color: #67c23a;
}

.status_late {
  background: #fef0e6;
  color: #e6a23c;
}

.status_early {
  background: #f0f0f0;
  color: #909399;
}

.status_absent {
  background: #fef0f0;
  color: #f56c6c;
}

.status_leave {
  background: #e8f4fd;
  color: #409EFF;
}

.attendance_actions {
  display: flex;
}

.action_btn {
  padding: 10rpx 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.edit_btn {
  background: #e8f4fd;
  color: #409EFF;
}

.edit_btn:active {
  opacity: 0.8;
}

.empty_state {
  text-align: center;
  padding: 120rpx 60rpx;
  color: #888;
}

.empty_icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty_text {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #666;
}

.empty_subtext {
  font-size: 26rpx;
  line-height: 1.6;
}

.add_attendance_btn {
  position: fixed;
  bottom: 30rpx;
  right: 30rpx;
  background: #FF4D61;
  color: #fff;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 77, 97, 0.4);
  z-index: 100;
}

.add_attendance_btn:active {
  opacity: 0.8;
}

.loadmore {
  text-align: center;
  padding: 40rpx 0;
  color: #888;
  font-size: 26rpx;
}

.loading {
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #ccc;
  border-top-color: #FF4D61;
  border-radius: 50%;
  animation: loading 1s linear infinite;
  margin-right: 15rpx;
  vertical-align: middle;
}

@keyframes loading {
  to { transform: rotate(360deg); }
}

.loadmore_tips_gray {
  color: #ccc;
}

/* 模态框样式 */
.modal_box {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.record_modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  z-index: 1001;
  overflow: hidden;
  max-height: 80vh;
}

.modal_title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}

.modal_content {
  padding: 30rpx;
  max-height: calc(80vh - 200rpx);
  overflow-y: auto;
}

.student_name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.form_item {
  margin-bottom: 30rpx;
}

.form_label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.status_options {
  display: flex;
  flex-wrap: wrap;
}

.status_option {
  padding: 20rpx 30rpx;
  margin: 0 10rpx 10rpx 0;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
}

.status_option.selected {
  border-color: #FF4D61;
  background: #fff1f0;
  color: #FF4D61;
}

.form_input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form_input:focus {
  border-color: #FF4D61;
}

.modal_footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.btn_cancel, .btn_confirm {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
}

.btn_cancel {
  color: #666;
  border-right: 1rpx solid #eee;
}

.btn_confirm {
  color: #FF4D61;
}

.btn_cancel:active, .btn_confirm:active {
  background: #f5f5f5;
}
