/* pages/class/manage/index.wxss */

.clearfix::after {
  content: "";
  display: table;
  clear: both;
}

.title {
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.list_title {
  float: left;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.create_btn {
  float: right;
  background: #FF4D61;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.create_btn:active {
  opacity: 0.8;
}

.list {
  background: #f5f5f5;
  min-height: calc(100vh - 120rpx);
}

.class_item {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.class_info {
  float: left;
  width: 70%;
}

.class_name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.class_detail {
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.class_detail .separator {
  margin: 0 10rpx;
  color: #ccc;
}

.class_date {
  font-size: 24rpx;
}

.color_888 {
  color: #888;
}

.class_actions {
  float: right;
  width: 30%;
  text-align: right;
}

.action_btn {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.detail_btn {
  background: #e8f4fd;
  color: #409EFF;
}

.delete_btn {
  background: #fff1f0;
  color: #FF4D4F;
}

.action_btn:active {
  opacity: 0.8;
}

.empty_state {
  text-align: center;
  padding: 120rpx 60rpx;
  color: #888;
}

.empty_icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty_text {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #666;
}

.empty_subtext {
  font-size: 26rpx;
  line-height: 1.6;
}

.loadmore {
  text-align: center;
  padding: 40rpx 0;
  color: #888;
  font-size: 26rpx;
}

.loading {
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #ccc;
  border-top-color: #FF4D61;
  border-radius: 50%;
  animation: loading 1s linear infinite;
  margin-right: 15rpx;
  vertical-align: middle;
}

@keyframes loading {
  to { transform: rotate(360deg); }
}

.loadmore_tips_gray {
  color: #ccc;
}

/* 创建班级模态框 */
.modal_box {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.create_modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  z-index: 1001;
  overflow: hidden;
}

.modal_title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}

.modal_content {
  padding: 30rpx;
}

.form_item {
  margin-bottom: 30rpx;
}

.form_label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.form_input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form_input:focus {
  border-color: #FF4D61;
}

.modal_footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.btn_cancel, .btn_confirm {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
}

.btn_cancel {
  color: #666;
  border-right: 1rpx solid #eee;
}

.btn_confirm {
  color: #FF4D61;
}

.btn_cancel:active, .btn_confirm:active {
  background: #f5f5f5;
}