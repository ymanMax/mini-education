.container {
  padding: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.tab-bar {
  display: flex;
  background: #f8f9fa;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #FF4D61;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #FF4D61;
  border-radius: 2rpx;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.notice-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.notice-type {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 15rpx;
  background: #e3f2fd;
  color: #1976d2;
}

.notice-meta {
  display: flex;
  justify-content: space-between;
  color: #888;
  font-size: 24rpx;
  margin-bottom: 15rpx;
}

.notice-content {
  color: #666;
  font-size: 28rpx;
  line-height: 1.5;
}
