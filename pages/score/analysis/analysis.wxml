<!-- 成绩分析页面 -->
<view class="container">
  <!-- 加载提示 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-content">
      <text class="loading-text">加载中...</text>
    </view>
  </view>

  <!-- 家长端模式提示 -->
  <view class="parent-mode-tip" wx:if="{{parentMode}}">
    <text class="tip-text">家长端模式</text>
  </view>

  <!-- 学生选择区域 -->
  <view class="student-selector" wx:if="{{!parentMode}}">
    <view class="selector-title">选择学生</view>
    <scroll-view class="student-list" scroll-x="true">
      <view
        class="student-item {{selectedStudent && selectedStudent.id === item.id ? 'active' : ''}}"
        wx:for="{{studentScores}}"
        wx:key="id"
        bindtap="selectStudent"
        data-student-id="{{item.id}}"
      >
        <text class="student-name">{{item.name}}</text>
        <text class="student-class">{{item.class}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 成绩概览 -->
  <view class="score-overview" wx:if="{{selectedStudent}}">
    <view class="overview-title">成绩概览</view>
    <view class="overview-content">
      <view class="overview-item">
        <text class="item-label">总分</text>
        <text class="item-value">{{selectedStudent.totalScore}}</text>
      </view>
      <view class="overview-item">
        <text class="item-label">平均分</text>
        <text class="item-value">{{selectedStudent.averageScore.toFixed(1)}}</text>
      </view>
      <view class="overview-item">
        <text class="item-label">班级排名</text>
        <text class="item-value">{{selectedStudent.classRank}}/{{selectedStudent.class.split('(')[1].split(')')[0]}}</text>
      </view>
      <view class="overview-item">
        <text class="item-label">年级排名</text>
        <text class="item-value">{{selectedStudent.gradeRank}}</text>
      </view>
    </view>
  </view>

  <!-- 学科成绩 -->
  <view class="subject-scores" wx:if="{{selectedStudent}}">
    <view class="section-title">学科成绩</view>
    <view class="subject-tabs">
      <view
        class="tab-item {{selectedSubject === 'all' ? 'active' : ''}}"
        bindtap="switchSubject"
        data-subject="all"
      >
        全部
      </view>
      <view
        class="tab-item {{selectedSubject === '语文' ? 'active' : ''}}"
        bindtap="switchSubject"
        data-subject="语文"
      >
        语文
      </view>
      <view
        class="tab-item {{selectedSubject === '数学' ? 'active' : ''}}"
        bindtap="switchSubject"
        data-subject="数学"
      >
        数学
      </view>
      <view
        class="tab-item {{selectedSubject === '英语' ? 'active' : ''}}"
        bindtap="switchSubject"
        data-subject="英语"
      >
        英语
      </view>
      <view
        class="tab-item {{selectedSubject === '理综' ? 'active' : ''}}"
        bindtap="switchSubject"
        data-subject="理综"
      >
        理综
      </view>
    </view>
    <view class="subject-list">
      <view
        class="subject-item"
        wx:for="{{selectedStudent.scores}}"
        wx:key="subject"
        wx:if="{{selectedSubject === 'all' || selectedSubject === item.subject}}"
      >
        <view class="subject-header">
          <text class="subject-name">{{item.subject}}</text>
          <text class="subject-score">{{item.score}}/{{item.fullScore}}</text>
        </view>
        <view class="subject-progress">
          <view class="progress-bar">
            <view
              class="progress-fill"
              style="width: {{(item.score / item.fullScore) * 100}}%""
            ></view>
          </view>
          <text class="progress-text">{{((item.score / item.fullScore) * 100).toFixed(1)}}%</text>
        </view>
        <view class="subject-rank">
          <text class="rank-text">班级排名: {{item.rank}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 成绩趋势分析 -->
  <view class="score-trend-section" wx:if="{{selectedStudent}}">
    <view class="section-title">成绩趋势分析</view>
    <view class="trend-content">
      <scroll-view class="trend-list" scroll-x="true">
        <view
          class="trend-item"
          wx:for="{{scoreTrend}}"
          wx:key="exam"
        >
          <text class="exam-name">{{item.exam}}</text>
          <text class="exam-score">{{item.totalScore}}</text>
          <text class="exam-rank">排名: {{item.rank}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 成绩对比分析 -->
  <view class="score-comparison-section" wx:if="{{selectedStudent}}">
    <view class="section-title">成绩对比分析</view>

    <!-- 班级排名 -->
    <view class="comparison-item">
      <view class="comparison-title">班级排名</view>
      <view class="ranking-list">
        <view
          class="ranking-item {{item.name === selectedStudent.name ? 'current-student' : ''}}"
          wx:for="{{classRanking}}"
          wx:key="name"
        >
          <text class="ranking-number">#{{item.rank}}</text>
          <text class="ranking-name">{{item.name}}</text>
          <text class="ranking-score">{{item.totalScore}}</text>
        </view>
      </view>
    </view>

    <!-- 年级排名 -->
    <view class="comparison-item">
      <view class="comparison-title">年级排名</view>
      <view class="ranking-list">
        <view
          class="ranking-item {{item.name === selectedStudent.name ? 'current-student' : ''}}"
          wx:for="{{gradeRanking}}"
          wx:key="name"
        >
          <text class="ranking-number">#{{item.rank}}</text>
          <text class="ranking-name">{{item.name}}</text>
          <text class="ranking-score">{{item.totalScore}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
