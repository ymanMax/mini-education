.container {
  padding: 30rpx;
}

.activity-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  text-align: center;
}

.activity-status {
  text-align: center;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  display: inline-block;
  margin-left: 50%;
  transform: translateX(-50%);
}

.activity-status.recruiting {
  background: #e8f5e9;
  color: #2e7d32;
}

.activity-status.closed {
  background: #ffebee;
  color: #c62828;
}

.activity-description {
  color: #666;
  font-size: 28rpx;
  line-height: 1.8;
  margin-bottom: 30rpx;
}

.activity-info {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  color: #666;
  font-size: 28rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 150rpx;
  color: #888;
}

.info-value {
  flex: 1;
}

.register-btn {
  background: #FF4D61;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 16rpx;
}
