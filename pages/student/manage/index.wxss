/* 学生管理页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-import,
.btn-export {
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
  background-color: #007aff;
  color: #fff;
}

.btn-export {
  background-color: #5ac8fa;
}

/* 学生列表 */
.student-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.student-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.student-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.sex {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  background-color: #e8f0fe;
  color: #007aff;
  border-radius: 15rpx;
}

.school {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.subject {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.student-item .action-buttons {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.btn-detail,
.btn-score,
.btn-attendance,
.btn-growth,
.btn-edit {
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  border-radius: 6rpx;
  border: none;
  background-color: #f0f0f0;
  color: #333;
}

.btn-detail {
  background-color: #007aff;
  color: #fff;
}

.btn-score {
  background-color: #5856d6;
  color: #fff;
}

.btn-attendance {
  background-color: #ff9500;
  color: #fff;
}

.btn-growth {
  background-color: #30d158;
  color: #fff;
}

.btn-edit {
  background-color: #8e8e93;
  color: #fff;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 60rpx;
  font-size: 30rpx;
  color: #666;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 15rpx;
  width: 90%;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  background-color: #f0f0f0;
  border: none;
  border-radius: 50%;
  font-size: 36rpx;
  color: #999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  line-height: 1;
}

.modal-body {
  padding: 40rpx;
  max-height: calc(80vh - 140rpx);
  overflow-y: auto;
}

.detail-item {
  display: flex;
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  width: 120rpx;
}

.value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 成绩列表样式 */
.score-list {
  margin-bottom: 30rpx;
}

.score-item {
  padding: 20rpx;
  margin-bottom: 15rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  border-left: 6rpx solid #007aff;
}

.score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.subject {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.score {
  font-size: 28rpx;
  font-weight: bold;
  color: #007aff;
}

.score-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.exam-type {
  padding: 6rpx 12rpx;
  background-color: #e8f0fe;
  color: #007aff;
  border-radius: 15rpx;
}

/* 考勤列表样式 */
.attendance-list {
  margin-bottom: 30rpx;
}

.attendance-item {
  padding: 20rpx;
  margin-bottom: 15rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  border-left: 6rpx solid #ff9500;
}

.attendance-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.status {
  padding: 6rpx 12rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.status-present {
  background-color: #e8f5e9;
  color: #388e3c;
}

.status-absent {
  background-color: #ffebee;
  color: #c62828;
}

.status-late {
  background-color: #fff3e0;
  color: #f57c00;
}

.status-leave {
  background-color: #e3f2fd;
  color: #1976d2;
}

.attendance-info {
  font-size: 24rpx;
  color: #666;
}

.reason {
  margin-right: 20rpx;
}

.approval {
  padding: 4rpx 8rpx;
  background-color: #e8f5e9;
  color: #388e3c;
  border-radius: 10rpx;
  font-size: 22rpx;
}

/* 成长档案样式 */
.growth-list {
  margin-bottom: 30rpx;
}

.growth-item {
  padding: 20rpx;
  margin-bottom: 15rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  border-left: 6rpx solid #30d158;
}

.growth-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.type {
  font-size: 28rpx;
  font-weight: bold;
  color: #30d158;
}

.growth-content {
  font-size: 24rpx;
  color: #666;
}

.growth-content .title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.growth-content .content {
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.comment {
  display: block;
  font-style: italic;
  color: #007aff;
}

/* 按钮样式 */
.btn-add-score,
.btn-add-attendance,
.btn-apply-leave,
.btn-add-growth {
  width: 100%;
  padding: 20rpx;
  margin-bottom: 15rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
  color: #fff;
}

.btn-add-score {
  background-color: #007aff;
}

.btn-add-attendance {
  background-color: #ff9500;
}

.btn-apply-leave {
  background-color: #5856d6;
}

.btn-add-growth {
  background-color: #30d158;
}
