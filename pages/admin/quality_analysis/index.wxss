/* pages/admin/quality_analysis/index.wxss */
.quality-analysis-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #FF4D61 0%, #FF6B81 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  color: white;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 科目成绩对比 */
.subject-comparison {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.subject-item {
  background-color: #f8f9fa;
  padding: 25rpx;
  border-radius: 12rpx;
}

.subject-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.course-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.course-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4D61;
}

.score-trend {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.trend-label {
  color: #666;
  margin-right: 10rpx;
}

.trend-value {
  font-weight: bold;
}

/* 教师排名 */
.teacher-ranking {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.teacher-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.rank {
  width: 50rpx;
  height: 50rpx;
  background-color: #FF4D61;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  margin-right: 20rpx;
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.subject {
  font-size: 24rpx;
  color: #666;
}

.teacher-score {
  font-size: 30rpx;
  font-weight: bold;
  color: #00C896;
}

/* 趋势图 */
.trend-chart {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.monthly-data {
  flex: 1;
  min-width: 120rpx;
  background-color: #f8f9fa;
  padding: 25rpx;
  border-radius: 12rpx;
  text-align: center;
}

.month {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.month-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4D61;
}
