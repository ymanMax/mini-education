/* pages/admin/student_source/index.wxss */
.student-source-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #FF4D61 0%, #FF6B81 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  color: white;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 地域分布 */
.region-distribution {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.region-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.region-info {
  display: flex;
  flex-direction: column;
}

.region-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.region-percentage {
  font-size: 24rpx;
  color: #666;
}

.student-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4D61;
}

/* 学校分布 */
.school-distribution {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.school-item {
  flex: 1;
  min-width: 150rpx;
  background-color: #f8f9fa;
  padding: 25rpx;
  border-radius: 12rpx;
  text-align: center;
}

.school-name {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.school-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #00C896;
}

/* 招生预测 */
.prediction-section {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.prediction-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.month {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.prediction-values {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.actual {
  font-size: 24rpx;
  color: #00C896;
  margin-bottom: 5rpx;
}

.predicted {
  font-size: 24rpx;
  color: #FFA500;
}
