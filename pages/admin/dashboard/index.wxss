/* pages/admin/dashboard/index.wxss */
.dashboard-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #FF4D61 0%, #FF6B81 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  color: white;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 统计卡片 */
.stats-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  flex: 1;
  min-width: 200rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF4D61;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.stat-trend {
  font-size: 24rpx;
}

/* 章节样式 */
.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.more-btn {
  font-size: 24rpx;
  color: #FF4D61;
  background: transparent;
  border: none;
  padding: 0;
}

.more-btn::after {
  border: none;
}

/* 教学质量分析 */
.quality-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.course-name {
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
}

.score-bar {
  flex: 1;
  height: 12rpx;
  background-color: #f0f0f0;
  border-radius: 6rpx;
  margin: 0 20rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  background: linear-gradient(90deg, #00C896 0%, #00E0B3 100%);
  border-radius: 6rpx;
}

.score-text {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
  text-align: right;
}

/* 生源分析 */
.source-analysis {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.source-item {
  background-color: #f8f9fa;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  text-align: center;
  min-width: 150rpx;
}

.region-name {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.student-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4D61;
}

/* 资源利用率 */
.utilization-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.resource-name {
  width: 150rpx;
  font-size: 28rpx;
  color: #333;
}

.utilization-bar {
  flex: 1;
  height: 12rpx;
  background-color: #f0f0f0;
  border-radius: 6rpx;
  margin: 0 20rpx;
  overflow: hidden;
}

.utilization-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFA500 0%, #FFC107 100%);
  border-radius: 6rpx;
}

.utilization-text {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
  text-align: right;
}

/* 导出按钮 */
.export-buttons {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.export-btn {
  flex: 1;
  min-width: 150rpx;
  background: linear-gradient(135deg, #FF4D61 0%, #FF6B81 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.export-btn::after {
  border: none;
}
