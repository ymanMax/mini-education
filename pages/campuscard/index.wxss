.container {
  padding: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.card-info {
  background: linear-gradient(135deg, #FF4D61, #ff6b81);
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  color: #fff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-number {
  font-size: 28rpx;
}

.card-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}

.balance-section {
  text-align: center;
  margin-bottom: 30rpx;
}

.balance-label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.balance-amount {
  font-size: 48rpx;
  font-weight: bold;
}

.recharge-section {
  display: flex;
  gap: 20rpx;
}

.recharge-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #fff;
}

.recharge-btn {
  background: rgba(255, 255, 255, 0.9);
  color: #FF4D61;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 16rpx 30rpx;
  font-weight: bold;
}

.record-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.record-desc {
  font-size: 28rpx;
  color: #333;
}

.record-amount {
  font-size: 28rpx;
  font-weight: bold;
}

.record-amount.income {
  color: #2e7d32;
}

.record-amount.expense {
  color: #c62828;
}

.record-meta {
  display: flex;
  justify-content: space-between;
  color: #888;
  font-size: 24rpx;
}
